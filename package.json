{
  "name": "akros",
  "private": true,
  "version": "0.1.0",
  "description": "Akros Immigration Solutions — plataforma digital (monorepo, Padrão SO v3).",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/prepare-hooks.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:functions": "DENO_NO_PACKAGE_JSON=1 deno test --allow-env=CORS_ALLOWED_ORIGINS supabase/functions",
    "test:gates": "node --test scripts/*.test.mjs",
    "check:edge-functions": "node --test scripts/check-edge-functions.test.mjs && node scripts/check-edge-functions.mjs",
    "audit:deps": "pnpm audit --prod --audit-level=high",
    "arch:check": "node --test scripts/arch-rules.test.mjs && depcruise apps/web/src --config .dependency-cruiser.cjs",
    "lint:migrations": "node --test scripts/lint-migrations.test.mjs && node scripts/lint-migrations.mjs",
    "ci:local": "lefthook run pre-push",
    "e2e": "pnpm --filter @akros/web exec playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.3.0",
    "dependency-cruiser": "^18.0.0",
    "lefthook": "^2.1.9",
    "squawk-cli": "^2.59.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
